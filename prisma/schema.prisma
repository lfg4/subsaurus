// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  email     String?  @unique @map("email")
  name      String?  @map("name")
  createdAt DateTime @default(now()) @map("createdAt")

  @@map("User")
}

model SlackUser {
  id               Int      @id @default(autoincrement())
  slackUserId      String   @unique @map("slack_user_id")
  slackWorkspaceId String   @map("slack_workspace_id")
  displayName      String?  @map("display_name")
  email            String?  @map("email")
  avatarUrl        String?  @map("avatar_url")
  role             String   @default("user") @map("role")
  isActive         Boolean  @default(true) @map("is_active")
  createdAt        DateTime @default(now()) @map("created_at")

  subscriptionUsers SubscriptionUser[]

  @@index([slackWorkspaceId])
  @@index([role])
  @@map("slack_users")
}

model Subscription {
  id                  Int      @id @default(autoincrement())
  slackWorkspaceId    String   @map("slack_workspace_id")
  createdBySlackUser  String   @map("created_by_slack_user_id")
  name                String
  projects            String[] @default([])
  renewalCycle        String   @map("renewal_cycle")
  renewalDate         DateTime @map("renewal_date")
  costAmount          Float    @map("cost_amount")
  costCurrency        String   @map("cost_currency")
  notes               String?
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  subscriptionUsers SubscriptionUser[]

  @@map("subscriptions")
}

model SubscriptionUser {
  id             Int      @id @default(autoincrement())
  slackWorkspaceId String @map("slack_workspace_id")
  subscriptionId Int      @map("subscription_id")
  slackUserId    String   @map("slack_user_id")
  createdAt      DateTime @default(now()) @map("created_at")

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  slackUser    SlackUser    @relation(fields: [slackUserId], references: [slackUserId], onDelete: Cascade)

  @@map("subscription_users")
}

model UsageCheck {
  id             Int      @id @default(autoincrement())
  slackWorkspaceId String @map("slack_workspace_id")
  subscriptionId Int      @map("subscription_id")
  periodStart      DateTime @default(now()) @map("period_start")
  periodEnd      DateTime @default(now()) @map("period_end")
  sendAt          DateTime @default(now()) @map("send_at")
  status         String
  createdAt      DateTime @default(now()) @map("created_at")

  @@map("usage_checks")
}

model UsageResponse {
  id             Int      @id @default(autoincrement())
  slackWorkspaceId String @map("slack_workspace_id")
  usageCheckId    Int     @map("usage_check_id")
  subscriptionId Int      @map("subscription_id")
  slackUserId     String  @map("slack_user_id")
  response        String?
  respondedAt     DateTime? @map("responded_at")
  createdAt      DateTime @default(now()) @map("created_at")

  @@map("usage_responses")
}

model AppSettings {
  id                    Int      @id @default(autoincrement())
  slackWorkspaceId      String   @unique @map("slack_workspace_id")
  daysBeforeRenewal     Int      @default(7) @map("days_before_renewal")
  isActive              Boolean  @default(true) @map("is_active")
  updatedAt             DateTime @updatedAt @map("updated_at")

  @@map("app_settings")
}

model Session {
  id               String   @id @default(uuid())
  slackUserId      String   @map("slack_user_id")
  slackWorkspaceId String   @map("slack_workspace_id")
  token            String   @unique @map("token")
  expiresAt        DateTime @map("expires_at")
  createdAt        DateTime @default(now()) @map("created_at")

  @@index([token])
  @@index([slackUserId])
  @@map("sessions")
}
